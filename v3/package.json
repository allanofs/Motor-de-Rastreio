{
  "name": "motor-rastreio-v3-foundation",
  "version": "3.0.0-alpha.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:dates": "vitest run tests/dates.test.ts",
    "schema:check": "vitest run tests/schemas.test.ts tests/content.test.ts tests/policyIsolation.test.ts",
    "build": "vite build",
    "check": "npm run typecheck && npm run schema:check && npm test && npm run build"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
